# --- Claude / caption generation ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5        # latest Sonnet; configurable

# --- Database ---
# Leave empty for local dev (falls back to sqlite:///dev.db in the project dir).
# On Render, use the Postgres *internal* connection string.
DATABASE_URL=

# --- App ---
APP_BASE_URL=http://localhost:5000     # https://<your-render-app>.onrender.com in prod
FLASK_SECRET_KEY=                      # any long random string
GENERATE_SECRET=                       # shared secret for POST /generate (X-Generate-Secret header)

# --- Dashboard ---
DASHBOARD_PASSWORD=                    # Dr. Ike's login password for the dashboard

# --- Publishing (all platforms) ---
USE_MOCK_PUBLISHER=true                # set false to publish for real

# --- Instagram ---
IG_USER_ID=                            # Instagram Business account user id
IG_ACCESS_TOKEN=                       # long-lived token (seeds ig_credentials on first run)

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=                 # OAuth token with w_member_social (or w_organization_social)
LINKEDIN_AUTHOR_URN=                   # urn:li:person:xxxx or urn:li:organization:xxxx
LINKEDIN_VERSION=202506                # LinkedIn-Version header (YYYYMM)

# --- Instagram token refresh (used only by refresh_token.py cron job; the
# --- IG Graph API runs on a Meta developer app) ---
FB_APP_ID=
FB_APP_SECRET=
